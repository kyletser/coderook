# CodeRook 环境配置模板
# 用法：cp .env.example .env，然后按需修改

# ── Core Daemon ───────────────────────────────────────────────
CODEROOK_HOST=127.0.0.1
CODEROOK_PORT=7437
# Core 首次启动自动生成；不要把 CODEROOK_IPC_TOKEN 写入项目 .env
CODEROOK_IPC_TOKEN_FILE=~/.coderook/ipc-token

# ── Logging ───────────────────────────────────────────────────
CODEROOK_LOG_LEVEL=INFO
# 留空则仅输出 stderr，不写文件
CODEROOK_LOG_FILE=~/.coderook/logs/core.log
# text（人工可读键值对）或 json（结构化，适合日志聚合）
CODEROOK_LOG_FORMAT=text

# ── Trace（默认不记录完整 LLM 正文）─────────────────────────
CODEROOK_TRACE_ENABLED=true
CODEROOK_TRACE_INCLUDE_PAYLOAD=false
CODEROOK_TRACE_INCLUDE_LLM_PAYLOAD=false
CODEROOK_TRACE_MAX_BYTES=10485760
CODEROOK_TRACE_BACKUP_COUNT=5

# ── Config File ───────────────────────────────────────────────
# CODEROOK_CONFIG=~/.coderook/config.toml

# ── LLM（本地推荐运行 `uv run coderook configure`）──────────────
# 交互式向导会把 API key 单独保存到 ~/.coderook/credentials.json。
# 以下变量主要用于 CI、容器或无交互部署，环境变量优先级最高。
# Anthropic:
# ANTHROPIC_API_KEY=sk-ant-...
# CODEROOK_LLM_PROVIDER=anthropic
# CODEROOK_LLM_DEFAULT_MODEL=claude-sonnet-4-6
# CODEROOK_LLM_BASE_URL=https://anthropic-compatible.example
#
# OpenAI-compatible:
# CODEROOK_LLM_PROVIDER=openai_compatible
# CODEROOK_LLM_BASE_URL=https://example.com/v1/chat/completions
# CODEROOK_LLM_API_KEY_ENV=CODEROOK_LLM_API_KEY
# CODEROOK_LLM_API_KEY=sk-...
# CODEROOK_LLM_DEFAULT_MODEL=deepseek-v4-pro
# CODEROOK_MAX_STEPS=20

# ── Web Search（可选）─────────────────────────────────
# 优先级：结构化端点 -> SearXNG -> DuckDuckGo HTML 兜底。
# 结构化端点的 Bearer key 用 CredentialStore 的 file:web-search 引用保存。
# CODEROOK_WEB_SEARCH_URL=https://search.example/v1/search
# CODEROOK_SEARXNG_URL=https://searxng.example
