{
  "name": "coderook-vscode",
  "displayName": "CodeRook",
  "description": "Minimal CodeRook runtime client for VS Code",
  "version": "0.1.0",
  "publisher": "coderook",
  "repository": {
    "type": "git",
    "url": "https://github.com/kyletser/coderook.git"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onCommand:coderook.send"
  ],
  "contributes": {
    "commands": [
      {
        "command": "coderook.newThread",
        "title": "CodeRook: New Thread"
      },
      {
        "command": "coderook.resumeThread",
        "title": "CodeRook: Resume Thread"
      },
      {
        "command": "coderook.send",
        "title": "CodeRook: Send Task"
      },
      {
        "command": "coderook.steer",
        "title": "CodeRook: Steer Active Turn"
      },
      {
        "command": "coderook.interrupt",
        "title": "CodeRook: Interrupt Active Turn"
      },
      {
        "command": "coderook.openDiff",
        "title": "CodeRook: Open Workspace Diff"
      }
    ],
    "configuration": {
      "title": "CodeRook",
      "properties": {
        "coderook.baseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:7438",
          "description": "CodeRook runtime API base URL"
        },
        "coderook.apiToken": {
          "type": "string",
          "default": "",
          "markdownDescription": "Bearer token. Prefer the `CODEROOK_API_TOKEN` environment variable when possible."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "check": "tsc --noEmit -p ./",
    "test:host": "npm run compile && node ./out/test/runTest.js",
    "prepackage": "node -e \"require('fs').mkdirSync('dist',{recursive:true})\"",
    "package": "npm run compile && vsce package --no-dependencies --out dist/coderook-vscode.vsix"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/vscode": "^1.134.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^7.0.2"
  }
}
